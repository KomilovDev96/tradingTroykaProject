generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  STOP_LOSS
}

enum Role {
  USER
  SUPERADMIN
}

enum ResetRequestStatus {
  OPEN
  RESOLVED
}

enum TradeResult {
  PROFIT
  STOP_LOSS
  MANUAL_CLOSE
}

/// Minimal single-tenant user. This app has no login flow (out of spec scope);
/// the backend upserts one default user at startup and owns all trades under it.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  trades    Trade[]
}

/// One row per confirmed 3H demand-range snapshot at the moment a signal was confirmed.
/// The range itself is a continuously-rolling window (see strategyEngine); a session
/// freezes the levels that were actually in effect for the trade(s) opened against it.
model TradingSession {
  id          String   @id @default(cuid())
  symbol      String
  strategy    String   @default("TROYKA")
  startTime   DateTime
  endTime     DateTime
  highDemand  Decimal
  lowDemand   Decimal
  rangePoints Decimal
  upperLevel  Decimal
  lowerLevel  Decimal
  createdAt   DateTime @default(now())
  trades      Trade[]
}

/// A confirmed Troyka signal, tracked as an analytical/virtual trade.
/// This app never sends a real order — see README section on scope.
model Trade {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  symbol    String
  direction Direction
  status    TradeStatus @default(OPEN)
  strategy  String      @default("TROYKA")
  timeframe String      @default("5m")

  sessionId String
  session   TradingSession @relation(fields: [sessionId], references: [id])

  rangeStart  DateTime
  rangeEnd    DateTime
  highDemand  Decimal
  lowDemand   Decimal
  rangePoints Decimal
  upperLevel  Decimal
  lowerLevel  Decimal

  movementStartTime  DateTime
  movementStartPrice Decimal
  confirmationTime   DateTime

  entryPrice Decimal
  stopLoss   Decimal

  exitPrice Decimal?
  exitTime  DateTime?
  pnlPoints Decimal?
  result    TradeResult?

  /// The account this position belongs to: every confirmed signal opens one row per
  /// non-paused account. Null only for rows recorded before accounts existed.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Identifies the confirmed movement (strategy|symbol|movementStartTime|direction).
  /// Section 47 dedup: one movement opens at most one position per account.
  signalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([signalId, accountId])
  @@index([accountId, status])
  @@index([signalId, status])
  @@index([symbol, status])
  @@index([createdAt])
  @@index([direction])
}

/// A person who can sign in to the dashboard. Separate from `User`, which is the single
/// system owner of trades and the analysis-paused flag — the analysis is shared by everyone.
model Account {
  id             String                 @id @default(cuid())
  /// Latin letters only (validated in src/auth/validation.ts).
  name           String
  /// Stored lower-cased.
  email          String                 @unique
  /// "+" and digits only. Required at sign-up; null only for the bootstrapped super admin.
  phone          String?                @unique
  /// scrypt$<salt>$<key> — see src/auth/password.ts.
  passwordHash   String
  role           Role                   @default(USER)
  /// «Остановить анализ» is per account: a paused account gets no new positions.
  analysisPaused Boolean                @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime               @default(now())
  sessions       AuthSession[]
  trades         Trade[]
  resetRequests  PasswordResetRequest[]
}

/// «Забыли пароль»: the user leaves their phone number; the super admin sets a new password
/// from the admin panel. Linked to an account when the phone matches one.
model PasswordResetRequest {
  id         String             @id @default(cuid())
  phone      String
  accountId  String?
  account    Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status     ResetRequestStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

/// Server-side login session. Only a SHA-256 of the cookie token is stored, so a DB leak
/// can't be replayed as a login; deleting the row logs that browser out immediately.
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}
