# Market data: Deriv's public WebSocket API (wss://api.derivws.com/trading/v1/options/ws/public).
# No API key, no account, no signup — it's a public, unauthenticated market-data endpoint.
# See README for the research behind this choice and its documented limitations.

# Deriv symbol notation. frxXAUUSD = Gold vs US Dollar (forex-style quoting of spot gold).
INSTRUMENT=frxXAUUSD

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (see docker-compose.yml at the repo root: `docker compose up -d`)
DATABASE_URL=postgresql://troyka:troyka@localhost:5433/troyka
