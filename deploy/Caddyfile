# Automatic HTTPS (Let's Encrypt) as soon as DNS for the domain points at this server.
{$DOMAIN} {
	encode gzip
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /ws {
		reverse_proxy backend:4000
	}
	handle {
		reverse_proxy frontend:80
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
